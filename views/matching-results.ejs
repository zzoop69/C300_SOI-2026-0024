<%- include("partials/header") %>

<section class="panel">
  <div class="section-heading">
    <div>
      <h2>Matching Results</h2>
      <p>Review one invoice at a time. Open details only when a record needs closer checking.</p>
    </div>
  </div>

  <% if (summaries.length === 0) { %>
    <div class="empty-state">No matching results yet. Upload and review documents first.</div>
  <% } else { %>
    <div class="table-wrap matching-summary-wrap">
      <table class="matching-summary-table">
        <thead>
          <tr>
            <th>Invoice Number</th>
            <th>Supplier Name</th>
            <th>PO Number</th>
            <th>DO/GRN Number</th>
            <th>Total Amount</th>
            <th>Overall Match Status</th>
            <th>Mismatch Found</th>
            <th>Discrepancy Count</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% summaries.forEach((summary) => { %>
            <tr>
              <td><strong><%= summary.invoiceNumber %></strong></td>
              <td><%= summary.supplierName %></td>
              <td><%= summary.poNumber %></td>
              <td><%= summary.doGrnNumber %></td>
              <td><%= summary.totalAmount %></td>
              <td>
                <span class="status <%= summary.overallMatchStatus.toLowerCase().replaceAll(' ', '-') %>">
                  <%= summary.overallMatchStatus %>
                </span>
              </td>
              <td>
                <% if (summary.mismatchFields.length === 0) { %>
                  <span class="muted-text">None</span>
                <% } else { %>
                  <div class="chip-list">
                    <% summary.mismatchFields.forEach((field) => { %>
                      <span class="chip"><%= field %></span>
                    <% }) %>
                  </div>
                <% } %>
              </td>
              <td><span class="count-pill"><%= summary.discrepancyCount %></span></td>
              <td>
                <a class="button compact-button" href="/matching-results/<%= encodeURIComponent(summary.invoiceId) %>">View Details</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include("partials/footer") %>