<%- include("partials/header") %>

<%
  const viewRecords = [...(locals.records || [])];
  const requestedFilter = locals.currentFilter || "all";
  const normalisedFilter = requestedFilter === "paid" ? "completed" : requestedFilter;
  const viewCurrentFilter = ["all", "pending", "approved", "rejected", "completed"].includes(normalisedFilter)
    ? normalisedFilter
    : "all";
  const viewSearchQuery = String(locals.searchQuery || "").trim();
  const normalisedSearchQuery = viewSearchQuery.toLowerCase();
  const viewSuccess = Boolean(locals.success);
  const viewWorkflowError = String(locals.workflowError || "");
  const statusClass = (value) => String(value || "neutral")
    .toLowerCase()
    .replaceAll(" ", "-")
    .replaceAll("/", "-");
  const formatPaymentDate = (value) => value
    ? new Date(`${value}T00:00:00`).toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
      })
    : "-";
  const formatPaymentTerm = (value) => {
    const compact = String(value || "").trim().toUpperCase().replace(/[^A-Z0-9]/g, "");
    const netMatch = compact.match(/^NET(\d+)$/);
    if (netMatch) return `Net ${netMatch[1]}`;
    if (compact === "DUEONRECEIPT") return "Due on Receipt";
    return String(value || "").trim() || "Not available";
  };
  const calculateSchedule = (invoiceDateValue, paymentTermValue, storedDueDate, storedDaysRemaining, storedPriority) => {
    let dueDate = storedDueDate || "";
    const compactTerm = String(paymentTermValue || "").trim().toUpperCase().replace(/[^A-Z0-9]/g, "");
    const netMatch = compactTerm.match(/^NET(\d+)$/);
    const supportedDays = compactTerm === "DUEONRECEIPT"
      ? 0
      : netMatch
        ? Number(netMatch[1])
        : null;

    if (!dueDate && invoiceDateValue && supportedDays !== null) {
      const invoiceDate = new Date(`${invoiceDateValue}T00:00:00Z`);
      if (!Number.isNaN(invoiceDate.getTime())) {
        invoiceDate.setUTCDate(invoiceDate.getUTCDate() + supportedDays);
        dueDate = invoiceDate.toISOString().slice(0, 10);
      }
    }

    let daysRemaining = storedDaysRemaining;
    if (daysRemaining == null && dueDate) {
      const now = new Date();
      const currentDate = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
      daysRemaining = Math.round((Date.parse(`${dueDate}T00:00:00Z`) - currentDate) / 86400000);
    }

    const priority = storedPriority || (
      daysRemaining == null
        ? "Manual Review Required"
        : daysRemaining < 0
          ? "Overdue"
          : daysRemaining <= 7
            ? "High"
            : daysRemaining <= 14
              ? "Medium"
              : "Low"
    );

    return { dueDate, daysRemaining, priority };
  };
  const isPending = (record) => ["Pending Approval", "Payment Held"].includes(record.paymentStatus);
  const isApproved = (record) => record.paymentStatus === "Approved for Payment";
  const isProcessing = (record) => record.paymentStatus === "Payment Processing";
  const isRejected = (record) => record.paymentStatus === "Rejected";
  const isCompleted = (record) => record.paymentStatus === "Paid";
  const searchableRecords = viewRecords.filter((record) => {
    if (!normalisedSearchQuery) return true;
    const searchableText = [
      record.invoice?.supplierName,
      record.purchaseOrder?.supplierName,
      record.invoice?.invoiceNumber,
      record.purchaseOrder?.poNumber,
    ].filter(Boolean).join(" ").toLowerCase();
    return searchableText.includes(normalisedSearchQuery);
  });
  const filters = [
    { key: "all", label: "All", count: searchableRecords.length },
    { key: "pending", label: "Pending", count: searchableRecords.filter(isPending).length },
    { key: "approved", label: "Approved", count: searchableRecords.filter(isApproved).length },
    { key: "rejected", label: "Rejected", count: searchableRecords.filter(isRejected).length },
    { key: "completed", label: "Completed", count: searchableRecords.filter(isCompleted).length },
  ];
  const filteredRecords = searchableRecords.filter((record) => {
    if (viewCurrentFilter === "pending") return isPending(record);
    if (viewCurrentFilter === "approved") return isApproved(record);
    if (viewCurrentFilter === "rejected") return isRejected(record);
    if (viewCurrentFilter === "completed") return isCompleted(record);
    return true;
  });
%>

<section class="panel payment-workflow-panel">
  <div class="section-heading workflow-heading">
    <div>
      <p class="eyebrow">Due soonest first</p>
      <h2>Payment Approval Workflow</h2>
      <p>Review document checks, approve eligible invoices, and track each payment through completion.</p>
    </div>
  </div>

  <% if (viewSuccess) { %>
    <div class="notice success-notice">Payment status updated successfully.</div>
  <% } %>
  <% if (viewWorkflowError) { %>
    <div class="notice error-notice"><%= viewWorkflowError %></div>
  <% } %>

  <form class="workflow-search" action="/payment-approval" method="GET" role="search">
    <input type="hidden" name="filter" value="<%= viewCurrentFilter %>">
    <label for="paymentWorkflowSearch">Search payments</label>
    <div class="workflow-search-controls">
      <input
        id="paymentWorkflowSearch"
        name="q"
        type="search"
        value="<%= viewSearchQuery %>"
        placeholder="Search supplier, invoice, or PO number"
        autocomplete="off"
      >
      <% if (viewSearchQuery) { %>
        <a class="button secondary-button" href="/payment-approval?filter=<%= viewCurrentFilter %>">Clear</a>
      <% } %>
    </div>
  </form>

  <nav class="workflow-tabs" aria-label="Payment workflow stages">
    <% filters.forEach((filter) => { %>
      <a
        class="<%= viewCurrentFilter === filter.key ? 'active' : '' %>"
        href="/payment-approval?filter=<%= filter.key %><%= viewSearchQuery ? `&q=${encodeURIComponent(viewSearchQuery)}` : '' %>"
        <%= viewCurrentFilter === filter.key ? 'aria-current="page"' : '' %>
      >
        <span><%= filter.label %></span>
        <strong><%= filter.count %></strong>
      </a>
    <% }) %>
  </nav>

  <div class="workflow-list-heading">
    <div>
      <h3><%= filters.find((filter) => filter.key === viewCurrentFilter)?.label || "All" %> payments</h3>
      <p id="workflowResultSummary">
        <span id="workflowResultCount"><%= filteredRecords.length %></span> record<span id="workflowResultPlural"><%= filteredRecords.length === 1 ? "" : "s" %></span>, ordered by nearest due date.
        <% if (viewSearchQuery) { %> Results for “<%= viewSearchQuery %>”.<% } %>
      </p>
    </div>
  </div>

  <% if (filteredRecords.length === 0) { %>
    <div class="empty-state"><%= viewSearchQuery ? "No payments match this search in the selected stage." : "No payments in this stage." %></div>
  <% } else { %>
    <div id="workflowSearchEmpty" class="empty-state" hidden>No payments match this search in the selected stage.</div>
    <div class="table-wrap workflow-table-wrap">
      <table class="workflow-table">
        <thead>
          <tr>
            <th>Supplier / Invoice</th>
            <th>Amount</th>
            <th>Document Checks</th>
            <th>Payment Stage</th>
            <th>Payment Schedule</th>
            <th>Invoice Date</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% filteredRecords.forEach((record) => { %>
            <%
              const displayedSupplier = isCompleted(record) && record.payment?.supplierName
                ? record.payment.supplierName
                : (record.invoice?.supplierName || record.purchaseOrder?.supplierName || "Needs review");
              const displayedAmount = isCompleted(record) && record.payment?.amountPaid
                ? record.payment.amountPaid
                : record.amountPayable;
              const displayedCurrency = isCompleted(record) && record.payment?.currency
                ? record.payment.currency
                : (record.paymentCurrency || "SGD");
              const displayedPaymentTerm = record.paymentTermDisplay || formatPaymentTerm(record.invoice?.paymentTermCode);
              const paymentSchedule = calculateSchedule(
                record.invoice?.documentDate || record.createdAt,
                record.invoice?.paymentTermCode,
                record.dueDate,
                record.daysRemaining,
                record.paymentPriority
              );
            %>
            <tr
              data-workflow-row
              data-search="<%= [
                displayedSupplier,
                record.purchaseOrder?.supplierName,
                record.invoice?.invoiceNumber,
                record.purchaseOrder?.poNumber,
              ].filter(Boolean).join(' ').toLowerCase() %>"
            >
              <td data-label="Supplier / Invoice">
                <strong><%= displayedSupplier %></strong>
                <span><%= record.invoice?.invoiceNumber || "Missing invoice" %> · <%= record.purchaseOrder?.poNumber || "Missing PO" %></span>
              </td>
              <td data-label="Amount">
                <strong><%= displayedCurrency %> <%= Number(displayedAmount || 0).toFixed(2) %></strong>
              </td>
              <td data-label="Document Checks">
                <div class="workflow-checks">
                  <span class="status <%= statusClass(record.matching.status) %>"><%= record.matching.status %></span>
                  <span class="status <%= statusClass(record.validation.status) %>"><%= record.validation.status %></span>
                  <% if (record.unresolvedDiscrepancies.length > 0) { %>
                    <span class="workflow-issue-count"><%= record.unresolvedDiscrepancies.length %> issue<%= record.unresolvedDiscrepancies.length === 1 ? "" : "s" %></span>
                  <% } %>
                </div>
              </td>
              <td data-label="Payment Stage">
                <span class="status <%= statusClass(record.paymentStatus) %>"><%= record.paymentStatus %></span>
              </td>
              <td data-label="Payment Schedule">
                <div class="payment-schedule" data-payment-schedule data-due-date="<%= paymentSchedule.dueDate %>">
                  <span><strong>Terms:</strong> <%= displayedPaymentTerm %></span>
                  <span><strong>Due:</strong> <span data-due-date-label><%= formatPaymentDate(paymentSchedule.dueDate) %></span></span>
                  <span data-days-remaining>
                    <strong>Remaining:</strong>
                    <%= paymentSchedule.daysRemaining == null
                      ? "Not calculated"
                      : paymentSchedule.daysRemaining < 0
                        ? `${Math.abs(paymentSchedule.daysRemaining)} day${Math.abs(paymentSchedule.daysRemaining) === 1 ? "" : "s"} overdue`
                        : `${paymentSchedule.daysRemaining} day${paymentSchedule.daysRemaining === 1 ? "" : "s"}` %>
                  </span>
                  <span class="priority-badge priority-<%= statusClass(paymentSchedule.priority) %>" data-priority>
                    <%= paymentSchedule.priority %>
                  </span>
                  <% if (paymentSchedule.priority === "Manual Review Required") { %>
                    <a class="payment-schedule-review" href="/extract/<%= encodeURIComponent(record.id) %>?mode=edit&from=validate-data">
                      Correct invoice details
                    </a>
                  <% } %>
                </div>
              </td>
              <td data-label="Invoice Date">
                <span class="workflow-date"><%= record.createdAt ? new Date(record.createdAt).toLocaleDateString("en-SG") : "-" %></span>
              </td>
              <td data-label="Action">
                <% if (isPending(record)) { %>
                  <div class="workflow-actions">
                    <form action="/payment-approval/<%= record.id %>/approve" method="POST">
                      <button type="submit" <%= record.canApprovePayment ? "" : "disabled" %>>Accept</button>
                    </form>
                    <form action="/payment-approval/<%= record.id %>/reject" method="POST">
                      <button class="danger-button" type="submit">Reject</button>
                    </form>
                  </div>
                  <% if (!record.canApprovePayment) { %>
                    <small class="workflow-block-reason">Resolve matching, validation, and discrepancy issues first.</small>
                  <% } %>
                <% } else if (isApproved(record)) { %>
                  <div class="workflow-actions">
                    <form
                      class="paypal-submit-form"
                      action="/payment-approval/<%= record.id %>/paypal"
                      method="POST"
                      data-paypal-submit-form
                    >
                      <button type="submit" <%= record.canApprovePayment ? "" : "disabled" %>>
                        <span class="paypal-submit-spinner" data-paypal-spinner hidden aria-hidden="true"></span>
                        <span data-paypal-button-text>Pay with PayPal Sandbox</span>
                      </button>
                      <small class="paypal-submit-message" data-paypal-submit-message hidden>
                        Submitting your payment to PayPal Sandbox. Please wait.
                      </small>
                    </form>
                  </div>
                  <% if (!record.canApprovePayment) { %>
                    <small class="workflow-block-reason">Payment is blocked because its document eligibility changed.</small>
                  <% } %>
                <% } else if (isProcessing(record)) { %>
                  <span class="workflow-no-action">In progress</span>
                <% } else if (isCompleted(record)) { %>
                  <a class="table-link" href="/receipt/<%= encodeURIComponent(record.id) %>">View Receipt</a>
                <% } else { %>
                  <span class="workflow-no-action">No action</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<script>
  (() => {
    const schedules = document.querySelectorAll("[data-payment-schedule]");
    if (!schedules.length) return;

    const today = new Date();
    const localToday = new Date(today.getFullYear(), today.getMonth(), today.getDate());

    schedules.forEach((schedule) => {
      const dueDateValue = schedule.dataset.dueDate;
      if (!dueDateValue) return;

      const [year, month, day] = dueDateValue.split("-").map(Number);
      const dueDate = new Date(year, month - 1, day);
      const daysRemaining = Math.round((dueDate - localToday) / 86400000);
      const remaining = schedule.querySelector("[data-days-remaining]");
      const priority = schedule.querySelector("[data-priority]");
      const priorityLabel = daysRemaining < 0
        ? "Overdue"
        : daysRemaining <= 7
          ? "High"
          : daysRemaining <= 14
            ? "Medium"
            : "Low";

      if (remaining) {
        const count = Math.abs(daysRemaining);
        remaining.innerHTML = `<strong>Remaining:</strong> ${
          daysRemaining < 0
            ? `${count} day${count === 1 ? "" : "s"} overdue`
            : `${daysRemaining} day${daysRemaining === 1 ? "" : "s"}`
        }`;
      }
      if (priority) {
        priority.textContent = priorityLabel;
        priority.className = `priority-badge priority-${priorityLabel.toLowerCase()}`;
      }
    });

    const nextDay = new Date(
      today.getFullYear(),
      today.getMonth(),
      today.getDate() + 1,
      0,
      0,
      1
    );
    window.setTimeout(() => window.location.reload(), nextDay.getTime() - today.getTime());

    const openedDateKey = `${today.getFullYear()}-${today.getMonth()}-${today.getDate()}`;
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) return;
      const current = new Date();
      const currentDateKey = `${current.getFullYear()}-${current.getMonth()}-${current.getDate()}`;
      if (currentDateKey !== openedDateKey) window.location.reload();
    });
  })();
</script>

<script>
  (() => {
    const searchForm = document.querySelector(".workflow-search");
    const searchInput = document.getElementById("paymentWorkflowSearch");
    const rows = [...document.querySelectorAll("[data-workflow-row]")];
    const emptyState = document.getElementById("workflowSearchEmpty");
    const resultCount = document.getElementById("workflowResultCount");
    const resultPlural = document.getElementById("workflowResultPlural");

    if (!searchForm || !searchInput) return;

    const applySearch = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      rows.forEach((row) => {
        const matches = !query || row.dataset.search.includes(query);
        row.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      if (emptyState) emptyState.hidden = visibleCount !== 0;
      if (resultCount) resultCount.textContent = visibleCount;
      if (resultPlural) resultPlural.textContent = visibleCount === 1 ? "" : "s";
    };

    searchForm.addEventListener("submit", (event) => event.preventDefault());
    searchInput.addEventListener("input", applySearch);
  })();
</script>

<script>
  (() => {
    document.querySelectorAll("[data-paypal-submit-form]").forEach((form) => {
      form.addEventListener("submit", (event) => {
        if (form.dataset.submitting === "true") {
          event.preventDefault();
          return;
        }

        form.dataset.submitting = "true";
        const button = form.querySelector("button[type='submit']");
        const spinner = form.querySelector("[data-paypal-spinner]");
        const buttonText = form.querySelector("[data-paypal-button-text]");
        const message = form.querySelector("[data-paypal-submit-message]");

        if (button) button.disabled = true;
        if (spinner) spinner.hidden = false;
        if (buttonText) buttonText.textContent = "Submitting payment\u2026";
        if (message) message.hidden = false;
      });
    });
  })();
</script>

<%- include("partials/footer") %>
