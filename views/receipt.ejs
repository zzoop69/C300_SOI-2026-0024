<%
  const gatewayStatusValue = String(paypalPayout?.status || "").toUpperCase();
  const terminalFailureStatuses = [
    "FAILED",
    "DENIED",
    "BLOCKED",
    "RETURNED",
    "REFUNDED",
    "CANCELED",
    "CANCELLED",
    "UNCLAIMED",
  ];
  const isPaid = record.paymentStatus === "Paid";
  const isFailure =
    record.paymentStatus === "Payment Held" ||
    terminalFailureStatuses.includes(gatewayStatusValue);
  const isProcessing = !isPaid && !isFailure;
  const supplierName =
    paypalPayout?.supplier_name ||
    record.invoice?.supplierName ||
    record.purchaseOrder?.supplierName ||
    "Supplier";
  const formattedAmount = paypalPayout
    ? `${paypalPayout.currency} ${Number(paypalPayout.amount).toFixed(2)}`
    : "-";
  const formatDateTime = (value) => {
    if (!value) return "-";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "-";
    return date.toLocaleString("en-SG", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  };
  const receiptPageTitle = isPaid
    ? "Payment Successful"
    : isFailure
      ? "Payment Unsuccessful"
      : "Payment Processing";
%>
<%- include("partials/header", { pageTitle: receiptPageTitle }) %>

<section class="panel receipt-panel receipt-state receipt-state--<%= isPaid ? "success" : isFailure ? "failure" : "processing" %>">
  <div class="receipt-state-header">
    <% if (isProcessing) { %>
      <span
        class="receipt-state-icon receipt-state-icon--processing"
        role="img"
        aria-label="Payment processing"
      ><span class="receipt-spinner" aria-hidden="true"></span></span>
      <div>
        <h2>Payment Processing</h2>
        <p>Your payment was submitted to PayPal. The status will update automatically.</p>
      </div>
    <% } else if (isPaid) { %>
      <span
        class="receipt-state-icon receipt-state-icon--success"
        role="img"
        aria-label="Payment successful"
      ><span aria-hidden="true">&#10003;</span></span>
      <div>
        <h2>Payment Successful</h2>
        <p>Payment successfully sent to <%= supplierName %>.</p>
      </div>
    <% } else { %>
      <span
        class="receipt-state-icon receipt-state-icon--failure"
        role="img"
        aria-label="Payment unsuccessful"
      ><span aria-hidden="true">!</span></span>
      <div>
        <h2>Payment Unsuccessful</h2>
        <p>PayPal could not complete this payment. The invoice was not marked Paid.</p>
      </div>
    <% } %>
  </div>

  <dl class="details-list receipt-details">
    <div><dt>Invoice Number</dt><dd><%= record.invoice?.invoiceNumber || "Missing" %></dd></div>
    <div><dt>Supplier</dt><dd><%= supplierName %></dd></div>

    <% if (isProcessing) { %>
      <div><dt>Supplier PayPal Email</dt><dd><%= paypalPayout?.recipient_email || "-" %></dd></div>
      <div><dt>Amount</dt><dd><%= formattedAmount %></dd></div>
      <div><dt>Submission Date and Time</dt><dd><%= formatDateTime(paypalPayout?.created_at) %></dd></div>
      <div><dt>PayPal Batch ID</dt><dd><%= paypalPayout?.paypal_batch_id || "-" %></dd></div>
      <div class="receipt-live-detail">
        <dt>Payment Status</dt>
        <dd id="receiptInvoiceStatus"><%= record.paymentStatus %></dd>
      </div>
      <div class="receipt-live-detail">
        <dt>Gateway Status</dt>
        <dd id="receiptGatewayStatus"><%= paypalPayout?.status || "-" %></dd>
      </div>
    <% } else if (isPaid) { %>
      <div><dt>Amount</dt><dd><%= formattedAmount %></dd></div>
      <div><dt>PayPal Payout Item ID</dt><dd><%= paypalPayout?.paypal_item_id || "-" %></dd></div>
      <div><dt>Completion Date and Time</dt><dd><%= formatDateTime(paypalPayout?.updated_at) %></dd></div>
      <div><dt>Final Gateway Status</dt><dd><%= paypalPayout?.status || "-" %></dd></div>
    <% } else { %>
      <div><dt>Amount</dt><dd><%= formattedAmount %></dd></div>
      <div><dt>Payment Status</dt><dd><%= record.paymentStatus %></dd></div>
      <div><dt>Final Gateway Status</dt><dd><%= paypalPayout?.status || "-" %></dd></div>
    <% } %>
  </dl>

  <% if (isProcessing && paypalPayout?.paypal_batch_id) { %>
    <div
      class="receipt-auto-status"
      id="receiptAutoStatus"
      role="status"
      aria-live="polite"
    >Waiting for PayPal confirmation&hellip;</div>
    <form action="/receipt/<%= record.id %>/refresh" method="POST" class="form-actions receipt-actions">
      <button type="submit">Check Status Manually</button>
    </form>
  <% } else if (isPaid) { %>
    <div class="form-actions receipt-actions">
      <a class="button" href="/payment-approval?filter=completed">View Completed Payments</a>
    </div>
  <% } else if (isFailure) { %>
    <div class="form-actions receipt-actions">
      <a class="button" href="/payment-approval">Return to Payment Approval</a>
    </div>
  <% } %>
</section>

<% if (isProcessing && paypalPayout?.paypal_batch_id) { %>
  <script>
    (() => {
      const statusUrl = "/receipt/<%= encodeURIComponent(record.id) %>/status";
      const pollingIntervalMs = 3000;
      const pollingDeadline = Date.now() + 60000;
      const statusMessage = document.getElementById("receiptAutoStatus");
      const gatewayStatus = document.getElementById("receiptGatewayStatus");
      const invoiceStatus = document.getElementById("receiptInvoiceStatus");
      let inFlight = false;
      let stopped = false;
      let timerId = null;

      function showStatusMessage(message) {
        if (statusMessage) statusMessage.textContent = message;
      }

      function stopWithPendingMessage() {
        stopped = true;
        if (timerId) window.clearTimeout(timerId);
        if (statusMessage) {
          statusMessage.classList.add("receipt-auto-status--timeout");
          statusMessage.textContent =
            "PayPal is still processing this payment. You may leave this page and check again later.";
        }
      }

      function scheduleNextCheck() {
        if (stopped) return;
        const remainingMs = pollingDeadline - Date.now();
        if (remainingMs <= 0) {
          stopWithPendingMessage();
          return;
        }
        showStatusMessage("Waiting for PayPal confirmation\u2026");
        timerId = window.setTimeout(checkPaymentStatus, Math.min(pollingIntervalMs, remainingMs));
      }

      async function checkPaymentStatus() {
        if (stopped || inFlight) return;
        if (Date.now() >= pollingDeadline) {
          stopWithPendingMessage();
          return;
        }

        inFlight = true;
        showStatusMessage("Checking PayPal payment status\u2026");
        try {
          const response = await fetch(statusUrl, {
            method: "GET",
            headers: { Accept: "application/json" },
            cache: "no-store",
          });
          const result = await response.json().catch(() => null);

          if (response.ok && result?.ok) {
            if (gatewayStatus) gatewayStatus.textContent = result.gatewayStatus;
            if (invoiceStatus) invoiceStatus.textContent = result.paymentStatus;

            if (result.final) {
              stopped = true;
              window.location.reload();
              return;
            }
          }
        } catch {
          // A temporary browser/network error is non-final. Try again normally.
        } finally {
          inFlight = false;
        }

        scheduleNextCheck();
      }

      scheduleNextCheck();
    })();
  </script>
<% } %>

<%- include("partials/footer") %>
