<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | Autonomous Supplier Payment Process</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="app-shell">
    <nav class="sidebar" aria-label="Main navigation">
      <div class="brand">
        <span>ASPP</span>
        <div>
          <strong>SupplierPay</strong>
          <small>Payment checks</small>
        </div>
      </div>
      <a class="<%= activePage === 'dashboard' ? 'active' : '' %>" href="/dashboard">Dashboard</a>
      <a class="<%= activePage === 'upload' ? 'active' : '' %>" href="/upload">Upload Documents</a>
      <a class="<%= activePage === 'review' ? 'active' : '' %>" href="/extracted-data">Extracted Data Review</a>
      <a class="<%= activePage === 'validate' ? 'active' : '' %>" href="/validate-data">Validate Data</a>
      <a class="<%= activePage === 'matching' ? 'active' : '' %>" href="/matching-results">Matching Results</a>
      <a class="<%= activePage === 'approval' ? 'active' : '' %>" href="/payment-approval">Payment Approval</a>
      <a class="<%= activePage === 'reports' ? 'active' : '' %>" href="/reports">Reports</a>
    </nav>

    <main class="content">
      <header class="page-header">
        <div class="page-header-title">
          <p class="eyebrow">Autonomous Supplier Payment Process</p>
          <h1><%= pageTitle %></h1>
        </div>
        <time
          id="currentDeviceDate"
          class="current-device-date"
          aria-label="Current date"
          aria-live="polite"
        ></time>
      </header>
      <script>
        (() => {
          const dateElement = document.getElementById("currentDeviceDate");
          if (!dateElement) return;

          let dateChangeTimer;
          const formatter = new Intl.DateTimeFormat("en-GB", {
            day: "numeric",
            month: "long",
            year: "numeric",
          });

          const updateCurrentDate = () => {
            const now = new Date();
            dateElement.textContent = `Date today: ${formatter.format(now)}`;
            dateElement.dateTime = [
              now.getFullYear(),
              String(now.getMonth() + 1).padStart(2, "0"),
              String(now.getDate()).padStart(2, "0"),
            ].join("-");

            window.clearTimeout(dateChangeTimer);
            const nextDay = new Date(
              now.getFullYear(),
              now.getMonth(),
              now.getDate() + 1,
              0,
              0,
              1
            );
            dateChangeTimer = window.setTimeout(updateCurrentDate, nextDay.getTime() - now.getTime());
          };

          updateCurrentDate();
          document.addEventListener("visibilitychange", () => {
            if (!document.hidden) updateCurrentDate();
          });
        })();
      </script>
